# =============================================================================
# Local configuration — copy to .env and edit (never commit .env)
#   cp .env.example .env        # macOS / Linux
#   copy .env.example .env      # Windows CMD
#   Copy-Item .env.example .env # Windows PowerShell
# =============================================================================

# --- Required ---
# Generate once:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=change-me-generate-a-long-random-secret

REDIS_URL=redis://localhost:6379/0

# Comma-separated origins (no spaces). Must match where the browser loads the app.
CORS_ORIGINS=http://localhost:5000

# --- Optional ---
# Static folder for the React build (default: ./client/webapp_build)
# FRONTEND_STATIC_FOLDER=./client/webapp_build

# Set to false when serving over HTTP locally (e.g. http://localhost:5000)
# SESSION_COOKIE_SECURE=false

# LOGIN_ATTEMPT_WINDOW_SECONDS=60
# LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
# LOGIN_MAX_ATTEMPTS_PER_IP=25
